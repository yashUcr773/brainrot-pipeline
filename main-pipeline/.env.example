# ElevenLabs Configuration (Required)
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_turbo_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_MAX_CHARS=2500

# OpenAI Configuration (Optional - for text improvement)
OPENAI_ENABLED=true
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_CHARS_PER_CHUNK=3000
OPENAI_MAX_TOKENS=1400
OPENAI_MAX_RETRIES=6

# Reddit Configuration
REDDIT_POST_LIMIT=16
REDDIT_TIME_FILTER=day
REDDIT_MIN_WORDS=20
REDDIT_MAX_WORDS=1500

# Video Configuration
BACKGROUND_SUBWAY=../videos/subway-surfer/
BACKGROUND_MINECRAFT=../videos/minecraft/
OUTPUT_DIR=output
FONT_PATH=../font/Comic-Sans-MS/Comic-Sans-MS.ttf
TEXT_SIZE=72
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Rendering Configuration
WORDS_PER_PAGE=6
MIN_PAGE_DURATION_SEC=0.7
DEFAULT_WPM=170

# Caching Configuration
CACHE_ENABLED=true
CACHE_HISTORY_FILE=cache/post_history.json
CACHE_MAX_HISTORY=1000

# Logging
LOG_LEVEL=info
